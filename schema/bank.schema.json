{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cyhkelvin/quizkit/schema/bank.schema.json",
  "title": "quizkit 題庫",
  "type": "object",
  "required": ["id", "group", "title", "version", "minutes", "passPercent", "questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$", "description": "題庫唯一 ID，也是網址結尾" },
    "group": { "type": "string", "minLength": 1, "description": "首頁分頁名稱" },
    "section": { "type": "string", "description": "分頁內的小標題，例如場次" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "code": { "type": "string", "description": "考試代碼，例如 SAA-C03" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "考試日；首頁同一分頁內依日期新到舊排序" },
    "version": { "type": "string", "minLength": 1 },
    "minutes": { "type": "number", "exclusiveMinimum": 0 },
    "passPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "shuffleFull": { "type": "boolean", "description": "完整考卷是否打亂題目順序" },
    "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "source": { "type": "string", "description": "題目來源與授權說明" },
    "note": { "type": "string" },
    "passages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/passage" }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "definitions": {
    "passage": {
      "type": "object",
      "required": ["blocks"],
      "additionalProperties": false,
      "properties": {
        "questions": { "type": "array", "items": { "type": "integer" }, "description": "共用這段說明的題號" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["text", "pre", "img"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["n", "q", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "domain": { "type": "integer", "minimum": 1 },
        "passage": { "type": "string" },
        "q": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string" } },
        "answer": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
          ]
        },
        "explanation": { "type": "string" },
        "figures": { "type": "array", "items": { "type": "string" } },
        "optionFigures": {
          "type": "array",
          "items": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] }
        }
      }
    }
  }
}
